    <formula name="paytext">"&lt;div dir=rtl align=right&gt;"&amp;'مجموع فیس پرداخت شده تا این تاریخ' &amp; ' ' &amp;"&lt;font color=red&gt;"&amp;replace(totext({sp_RptPaymentBalance.StdPay},0 ),',','')&amp;"&lt;/font&gt;" &amp;' افغانی '&amp;"&lt;/div&gt;"</formula>
