    <formula name="rptheder">//{?heder1}+' '+{@fasl}+' مبلغ '+{@balance}+' افغانی '+{?heder2}
"&lt;div dir=rtl align=center&gt;"&amp; ' لیست دانش آموزان بدهکار  ' &amp;"&lt;font color=red&gt;"&amp;{@fasl}&amp;"&lt;/font&gt;"
&amp;"&lt;/div&gt;"</formula>
    <formula name="fasl">if{?type}=1 and ({sp_RptPaymentBalance.Fasl}=1) then 'سه ماهه بهار'
else if {?type}=1 and  ({sp_RptPaymentBalance.Fasl}=2) then 'سه ماهه تابستان'
else if {?type}=1 and ({sp_RptPaymentBalance.Fasl}=3) then 'سه ماهه خزان'

else if {?type}=2 and ({sp_RptPaymentBalance.Fasl}=1) then 'ماه '+'حمل'
else if {?type}=2 and ({sp_RptPaymentBalance.Fasl}=2) then 'ماه '+'ثور'
else if {?type}=2 and ({sp_RptPaymentBalance.Fasl}=3) then 'ماه '+'جوزا'
else if {?type}=2 and ({sp_RptPaymentBalance.Fasl}=4) then 'ماه '+'سرطان'
else if {?type}=2 and ({sp_RptPaymentBalance.Fasl}=5) then 'ماه '+'اسد'
else if {?type}=2 and ({sp_RptPaymentBalance.Fasl}=6) then 'ماه '+'سنبله'
else if {?type}=2 and ({sp_RptPaymentBalance.Fasl}=7) then 'ماه '+'میزان'
else if {?type}=2 and ({sp_RptPaymentBalance.Fasl}=8) then 'ماه '+'عقرب'
else if {?type}=2 and ({sp_RptPaymentBalance.Fasl}=9) then 'ماه '+'قوس'</formula>
    <formula name="balance">{sp_RptPaymentBalance.Balance}</formula>
    <formula name="stdpay">{sp_RptPaymentBalance.StdPay}</formula>
    <formula name="sumBalance">sum({@balance},{@xClass})</formula>
    <formula name="SumStdPay">sum({@stdpay},{@xClass})</formula>
    <formula name="stdPayFee">{sp_RptPaymentBalance.Pay_Fee}</formula>
    <formula name="stdPayTrans">{sp_RptPaymentBalance.Pay_Transport}</formula>
    <formula name="balance_fee">{sp_RptPaymentBalance.Balance_Fee}</formula>
    <formula name="balance_trans">{sp_RptPaymentBalance.Balance_Transport}</formula>
  </formulas>
