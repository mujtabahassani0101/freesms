else if{sp_List_books_RengMark.mark}&lt;24 then 4
else if{sp_List_books_RengMark.mark}&lt;30 then 3
else if{sp_List_books_RengMark.mark}&lt;36 then 2
else if{sp_List_books_RengMark.mark}&lt;=40 then 1
</formula>
